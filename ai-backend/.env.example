# ─────────────────────────────────────────────────────────────────────────────
# ai-backend Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git.
# All production values are set in the Vercel dashboard.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (dedicated AI project — NEVER the Tashus main project) ──────────
# Source: Supabase dashboard → Settings → API
SUPABASE_URL=https://your-ai-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here
# GROK_API_KEYS=your-groq-api-key-1,your-groq-api-key-2
# ── Redis ─────────────────────────────────────────────────────────────────────
# Upstash Redis URL (or self-hosted)
# Used for: rate limiting, BullMQ queues, cache, pub/sub circuit-breaker
REDIS_URL=redis://default:your-password@your-redis-host:6379

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Primary: Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Optional: Grok (xAI) as primary with Anthropic fallback
# GROK_API_KEYS=grok-key-1,grok-key-2
# GROK_API_BASE_URL=https://api.x.ai

# ── Embedding Provider ────────────────────────────────────────────────────────
# Choose one: openai | voyage
EMBEDDING_PROVIDER=openai
EMBEDDING_PROVIDER_API_KEY=sk-your-embedding-api-key
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSION=1536

# ── Tashus API (read-only adapter) ───────────────────────────────────────────
# Base URL for tashus-adapter/client.ts — GET only, never POST/PUT/DELETE
TASHUS_API_BASE_URL=https://api.tashus.com

# Optional: JWKS endpoint for verifying Tashus JWTs passed through widget
# TASHUS_JWT_JWKS_URL=https://api.tashus.com/.well-known/jwks.json

# ── Admin Panel Auth ──────────────────────────────────────────────────────────
# Must be at least 32 characters. Must match value in ai-admin/.env.local
# NEVER reuse the Tashus NEXTAUTH_SECRET value here
JWT_SIGNING_SECRET_ADMIN=generate-a-32-char-random-secret-here

# ── Email Channel (optional — Phase 5) ───────────────────────────────────────
# Required only if enabling the email inbound webhook channel
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=support@tashus.com
# SMTP_PASS=your-app-password
# SMTP_FROM=support@tashus.com

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3001
