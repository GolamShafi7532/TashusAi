# ─────────────────────────────────────────────────────────────────────────────
# ai-admin Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git.
# All production values are set in the Vercel dashboard.
# ─────────────────────────────────────────────────────────────────────────────

# ── Backend URL ───────────────────────────────────────────────────────────────
# The public URL of the deployed ai-backend service
# In production: https://ai.tashus.com
NEXT_PUBLIC_AI_BACKEND_URL=http://localhost:3001

# ── Supabase (same dedicated AI project as ai-backend) ───────────────────────
# Must point to the SAME Supabase project as ai-backend
SUPABASE_URL=https://your-ai-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# ── Admin Panel Auth ──────────────────────────────────────────────────────────
# MUST be the exact same value as JWT_SIGNING_SECRET_ADMIN in ai-backend
# Used to verify admin session tokens issued by the backend
JWT_SIGNING_SECRET_ADMIN=generate-a-32-char-random-secret-here
