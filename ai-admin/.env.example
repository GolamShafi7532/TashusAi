# ─────────────────────────────────────────────────────────────────────────────
# ai-admin Environment Variables
# Copy to .env.local for local dev. Set in Vercel dashboard for production.
# NEVER commit .env.local to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Backend URL ───────────────────────────────────────────────────────────────
# NEXT_PUBLIC_ prefix = available in browser (client components, apiFetch calls)
# AI_BACKEND_URL = server-side only (API route handlers like token-bucket, notifications)
# Both must point to the same deployed ai-backend URL in production.
NEXT_PUBLIC_AI_BACKEND_URL=https://tashus-ai-backend.bepario.com
AI_BACKEND_URL=https://tashus-ai-backend.bepario.com

# ── Supabase (same dedicated AI project as ai-backend) ───────────────────────
# Source: Supabase Dashboard → Settings → API
# MUST be the same project as ai-backend — they share the same DB.
SUPABASE_URL=https://your-ai-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# ── Redis (same Upstash instance as ai-backend) ───────────────────────────────
# Used for admin notifications SSE (subscribes to admin:notifications channel)
# Use rediss:// (double-s) for TLS — required by Upstash
REDIS_URL=rediss://default:your-password@your-host.upstash.io:6379

# ── Admin JWT Auth ────────────────────────────────────────────────────────────
# MUST be the EXACT SAME value as JWT_SIGNING_SECRET_ADMIN in ai-backend.
# Generate with: openssl rand -base64 32
# Min 32 characters. Never reuse from any other project.
JWT_SIGNING_SECRET_ADMIN=generate-a-32-char-random-secret-here

# ── Embedding Provider ────────────────────────────────────────────────────────
# Used when admin uploads documents via the knowledge base UI.
# Must match the values in ai-backend so vectors are compatible.
EMBEDDING_PROVIDER=openai
EMBEDDING_PROVIDER_API_KEY=sk-your-openai-key-here
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSION=1536
