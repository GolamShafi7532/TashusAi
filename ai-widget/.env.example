# ─────────────────────────────────────────────────────────────────────────────
# ai-widget Build-Time Environment Variables
# Copy this file to .env.local for local development.
# NEVER commit .env.local to git.
# Production values are set in the Vercel dashboard.
#
# Note: All VITE_ prefixed vars are embedded into the bundle at build time.
# Do NOT put secrets here — this bundle is served publicly to browsers.
# ─────────────────────────────────────────────────────────────────────────────

# ── Backend URL ───────────────────────────────────────────────────────────────
# The public URL of the deployed ai-backend service.
# This is embedded in the widget bundle — it MUST be a public HTTPS URL in prod.
# In development: http://localhost:3001
VITE_AI_BACKEND_URL=https://tashus-ai-backend.bepario.com
